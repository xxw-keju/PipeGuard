{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pipeguard.dev/schema/pgir-parametric-v1.json",
  "title": "PipeGuard parameterized logical-stream IR v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "producer", "target", "assumptions",
    "control_structure", "owners", "program_streams", "resources",
    "regions", "event_templates", "frontend_provenance",
    "frontend_evidence", "unsupported_constructs"
  ],
  "properties": {
    "schema_version": {"const": "pgir-parametric-v1"},
    "producer": {"type": "object"},
    "target": {"type": "object"},
    "assumptions": {"type": "object"},
    "control_structure": {"type": "object"},
    "owners": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "participants"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "kind": {"enum": ["LANE", "WARP", "WARPGROUP", "PARTITION", "ASYNC_ENGINE"]},
          "participants": {
            "type": "array", "minItems": 1, "uniqueItems": true,
            "items": {"type": "integer", "minimum": 0}
          }
        }
      }
    },
    "program_streams": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "instances"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "kind": {"const": "LANE"},
          "instances": {
            "type": "array", "minItems": 1, "uniqueItems": true,
            "items": {"type": "integer", "minimum": 0}
          }
        }
      }
    },
    "resources": {"type": "array", "items": {"type": "object"}},
    "regions": {"type": "array", "items": {"type": "object"}},
    "event_templates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "type", "stream", "order", "fields"],
        "oneOf": [
          {"required": ["execution_scope", "instances"]},
          {"required": ["program_instances", "executors", "transition", "rendezvous"]}
        ],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "type": {"type": "string", "minLength": 1},
          "stream": {"type": "string", "minLength": 1},
          "order": {"type": "integer", "minimum": 0},
          "execution_scope": {"enum": ["INSTANCE", "ELECTED", "COLLECTIVE"]},
          "instances": {
            "type": "array", "minItems": 1, "uniqueItems": true,
            "items": {"type": "integer", "minimum": 0}
          },
          "program_instances": {
            "type": "array", "minItems": 1, "uniqueItems": true,
            "items": {"type": "integer", "minimum": 0}
          },
          "executors": {
            "type": "array", "minItems": 1, "uniqueItems": true,
            "items": {"type": "integer", "minimum": 0}
          },
          "transition": {"enum": ["PER_INSTANCE", "ONCE"]},
          "rendezvous": {"enum": ["NONE", "ALL_PROGRAM_INSTANCES"]},
          "owner": {"type": "string", "minLength": 1},
          "fields": {"type": "object"},
          "instance_fields": {
            "type": "object",
            "additionalProperties": {"type": "array"}
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["template", "relation"],
              "properties": {
                "template": {"type": "string", "minLength": 1},
                "relation": {"enum": ["SAME_INSTANCE", "ALL_INSTANCES", "COLLECTIVE"]}
              }
            }
          }
        }
      }
    },
    "frontend_provenance": {"type": "object"},
    "frontend_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["participant_mapping", "lane_ownership", "predicate_mapping", "alias"],
      "properties": {
        "participant_mapping": {"$ref": "#/$defs/evidence"},
        "lane_ownership": {"$ref": "#/$defs/evidence"},
        "predicate_mapping": {"$ref": "#/$defs/evidence"},
        "alias": {"$ref": "#/$defs/evidence"}
      }
    },
    "unsupported_constructs": {
      "type": "array", "uniqueItems": true,
      "items": {"type": "string"}
    }
  },
  "$defs": {
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "method", "source"],
      "properties": {
        "status": {"enum": ["RESOLVED", "EXACT"]},
        "method": {"type": "string", "minLength": 1},
        "source": {"type": "string", "minLength": 1}
      }
    }
  }
}
