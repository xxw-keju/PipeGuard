{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pipeguard.dev/schema/pgir-v1.json",
  "title": "PipeGuard IR v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "producer", "target", "assumptions", "control_structure", "actors", "resources", "regions", "events", "frontend_provenance", "unsupported_constructs"],
  "properties": {
    "schema_version": {"const": "pgir-v1"},
    "producer": {
      "type": "object", "additionalProperties": false,
      "required": ["dsl", "dsl_version", "dsl_commit", "backend_commit", "adapter_version", "command"],
      "properties": {
        "dsl": {"enum": ["TILELANG", "TRITON"]}, "dsl_version": {"type": "string", "minLength": 1},
        "dsl_commit": {"type": "string", "minLength": 1}, "backend_commit": {"type": "string", "minLength": 1},
        "adapter_version": {"type": "string", "minLength": 1}, "command": {"type": "string", "minLength": 1}
      }
    },
    "target": {
      "type": "object", "additionalProperties": false,
      "required": ["architecture", "warp_size", "cta_threads", "shared_memory_bytes", "grid_scope"],
      "properties": {
        "architecture": {"const": "sm90"}, "warp_size": {"const": 32},
        "cta_threads": {"type": "integer", "minimum": 1}, "shared_memory_bytes": {"type": "integer", "minimum": 0},
        "grid_scope": {"const": "single_cta"},
        "launch_grid": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "integer", "minimum": 1}},
        "selected_cta": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "integer", "minimum": 0}}
      },
      "dependentRequired": {
        "launch_grid": ["selected_cta"],
        "selected_cta": ["launch_grid"]
      }
    },
    "assumptions": {
      "type": "object", "additionalProperties": false,
      "required": ["finite_control_flow", "statically_known_participants", "parity_normalization_status", "alias_precision", "fair_async_completion", "no_cluster_effects"],
      "properties": {
        "finite_control_flow": {"const": true}, "statically_known_participants": {"const": true},
        "parity_normalization_status": {"enum": ["RESOLVED", "UNRESOLVED"]},
        "alias_precision": {"enum": ["EXACT", "UNKNOWN"]},
        "fair_async_completion": {"const": true}, "no_cluster_effects": {"const": true}
      }
    },
    "control_structure": {
      "type": "object", "additionalProperties": false, "required": ["finite_event_graph"],
      "properties": {"finite_event_graph": {"const": true}}
    },
    "frontend_provenance": {
      "type": "object", "additionalProperties": false, "required": ["extraction_complete", "source"],
      "properties": {
        "extraction_complete": {"const": true}, "source": {"type": "string", "minLength": 1},
        "final_ptx": {
          "type": "object", "additionalProperties": false, "required": ["sha256", "text"],
          "properties": {"sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "text": {"type": "string", "minLength": 1}}
        }
      }
    },
    "actors": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/actor"}},
    "resources": {"type": "array", "items": {"$ref": "#/$defs/resource"}},
    "regions": {"type": "array", "items": {"$ref": "#/$defs/region"}},
    "events": {"type": "array", "items": {"$ref": "#/$defs/event"}},
    "unsupported_constructs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
  },
  "$defs": {
    "actor": {
      "type": "object", "additionalProperties": false, "required": ["id", "kind", "participants"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "kind": {"enum": ["LANE", "WARP", "WARPGROUP", "PARTITION", "ASYNC_ENGINE"]},
        "participants": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "integer", "minimum": 0}},
        "role": {"enum": ["PROGRAM_STREAM", "EXECUTION_OWNER", "BOTH", "ASYNC_ENGINE"]}
      }
    },
    "resource": {
      "type": "object", "additionalProperties": false, "required": ["id", "kind", "participants"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "kind": {"enum": ["mbarrier", "cta_barrier", "named_barrier", "async_group", "channel"]},
        "participants": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "capacity": {"type": "integer", "minimum": 1, "description": "Collective/channel capacity. Legacy async_group capacity is accepted but ignored; commit groups have no semantic capacity."},
        "protocol": {"enum": ["CP_ASYNC", "WGMMA", "TMA_STORE"]},
        "scope": {"const": "CTA"},
        "visibility_mask": {"$ref": "#/$defs/visibility_mask"}
      }
    },
    "region": {
      "type": "object", "additionalProperties": false, "required": ["id", "allocation_id", "address_space", "offset", "extent"],
      "properties": {
        "id": {"type": "string", "minLength": 1}, "allocation_id": {"type": "string", "minLength": 1},
        "address_space": {"enum": ["SHARED", "GLOBAL", "REGISTER", "TENSOR"]}, "offset": {"type": "integer", "minimum": 0},
        "extent": {"type": "integer", "minimum": 1}
      }
    },
    "parity_evidence": {
      "type": "object", "additionalProperties": false, "required": ["derivation_kind", "logical_stream_id", "lifecycle_epoch", "stream_rank", "polling_coalesced"],
      "properties": {
        "derivation_kind": {"enum": ["STATIC_ITERATION", "PHASE_SSA", "BARRIER_HISTORY", "PARITY_EXPRESSION"]},
        "logical_stream_id": {"type": "string", "minLength": 1}, "lifecycle_epoch": {"type": "integer", "minimum": 0},
        "stream_rank": {"type": "integer", "minimum": 0}, "polling_coalesced": {"const": true}
      }
    },
    "visibility_mask": {
      "type": "object", "additionalProperties": false,
      "required": ["shared", "global_read", "global_write", "tensor_read", "tensor_write", "control_only"],
      "properties": {
        "shared": {"type": "boolean"}, "global_read": {"type": "boolean"},
        "global_write": {"type": "boolean"}, "tensor_read": {"type": "boolean"},
        "tensor_write": {"type": "boolean"}, "control_only": {"type": "boolean"}
      }
    },
    "tma_transfer": {
      "type": "object", "additionalProperties": false,
      "required": ["source_region", "destination_region", "bytes"],
      "properties": {
        "source_region": {"type": "string", "minLength": 1},
        "destination_region": {"type": "string", "minLength": 1},
        "bytes": {"type": "integer", "minimum": 1}
      }
    },
    "event": {
      "type": "object", "additionalProperties": false, "required": ["id", "type", "actor", "seq"],
      "properties": {
        "id": {"type": "string", "minLength": 1}, "type": {"type": "string", "minLength": 1},
        "actor": {"type": "string", "minLength": 1}, "seq": {"type": "integer", "minimum": 0},
        "owner": {"type": "string", "minLength": 1},
        "depends_on": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "resource": {"type": "string", "minLength": 1}, "region": {"type": "string", "minLength": 1},
        "source_region": {"type": "string", "minLength": 1}, "destination_region": {"type": "string", "minLength": 1},
        "regions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "transfers": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/tma_transfer"}},
        "count": {"type": "integer", "minimum": 1}, "bytes": {"type": "integer", "minimum": 1},
        "lifecycle_epoch": {"type": "integer", "minimum": 0},
        "generation": {"type": "integer", "minimum": 0}, "layout": {"enum": ["V0", "V1"]},
        "raw_parity": {"type": "integer", "minimum": 0, "maximum": 1},
        "parity_evidence": {"$ref": "#/$defs/parity_evidence"}, "predicate": {"type": "boolean"},
        "invocation_id": {"type": "integer", "minimum": 0},
        "async_resource": {"type": "string", "minLength": 1},
        "group_owner": {"type": "string", "minLength": 1}, "group_seq": {"type": "integer", "minimum": 0},
        "wait_group_count": {"type": "integer", "minimum": 0},
        "completion_kind": {"enum": ["GROUP_COMPLETE", "OPERANDS_RELEASED", "RESULT_READY", "SOURCE_RELEASED", "GLOBAL_COMPLETE"]},
        "wait_mode": {"enum": ["READ_ONLY", "GLOBAL"]},
        "reduction": {"type": "boolean"},
        "engine_id": {"type": "string", "minLength": 1}, "engine_seq": {"type": "integer", "minimum": 0},
        "slot": {"type": "integer", "minimum": 0}, "logical_phase": {"type": "integer", "minimum": 0},
        "from_domain": {"enum": ["GENERIC", "ASYNC_COPY", "TMA", "TENSOR_CORE"]},
        "to_domain": {"enum": ["GENERIC", "ASYNC_COPY", "TMA", "TENSOR_CORE"]},
        "scope": {"const": "CTA"}, "visibility_mask": {"$ref": "#/$defs/visibility_mask"}
      }
    }
  }
}
