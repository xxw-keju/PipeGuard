{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pipeguard.dev/schemas/upstream-capsule-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "candidate_id", "dsl", "upstream", "candidate_kind", "role", "decorators", "lexical_parents", "kernel_dependencies", "free_names", "unresolved_bindings", "capsule", "recipe_paths"],
  "properties": {
    "schema_version": {"const": "pipeguard-upstream-capsule-v1"},
    "candidate_id": {"type": "string", "pattern": "^[0-9a-f]{16}$"},
    "dsl": {"enum": ["tilelang", "triton"]},
    "upstream": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit", "relative_path", "git_blob", "source_sha256", "selected_source_sha256", "start_line", "end_line", "qualname"],
      "properties": {
        "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "relative_path": {"type": "string"},
        "git_blob": {"type": "string", "pattern": "^[0-9a-f]{40,64}$"},
        "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "selected_source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "start_line": {"type": "integer", "minimum": 1},
        "end_line": {"type": "integer", "minimum": 1},
        "qualname": {"type": "string"}
      }
    },
    "candidate_kind": {"type": "string"},
    "role": {"enum": ["ROOT", "HELPER", "ROOT_HELPER", "UNCLASSIFIED"]},
    "decorators": {"type": "array", "items": {"type": "string"}},
    "lexical_parents": {"type": "array", "items": {"type": "string"}},
    "kernel_dependencies": {"type": "array", "items": {"type": "string", "pattern": "^[0-9a-f]{16}$"}},
    "free_names": {"type": "array", "items": {"type": "string"}},
    "unresolved_bindings": {"type": "array", "items": {"type": "string"}},
    "capsule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "resolver", "source_map"],
      "properties": {
        "path": {"type": "string"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "resolver": {"const": "pipeguard_resolve"},
        "source_map": {
          "type": "object",
          "additionalProperties": false,
          "required": ["logical_path", "start_line", "end_line"],
          "properties": {
            "logical_path": {"type": "string"},
            "start_line": {"type": "integer", "minimum": 1},
            "end_line": {"type": "integer", "minimum": 1}
          }
        }
      }
    },
    "recipe_paths": {"type": "array", "minItems": 1, "items": {"type": "string"}}
  }
}
