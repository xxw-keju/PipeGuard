{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pipeguard.dev/schemas/mutation-workload-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "recipe_id", "kernel_id", "dsl", "bindings", "materialization", "compiler", "numeric", "target"],
  "properties": {
    "schema_version": {"const": "pipeguard-mutation-workload-v1"},
    "recipe_id": {"type": "string", "minLength": 1},
    "kernel_id": {"type": "string", "minLength": 1},
    "dsl": {"enum": ["tilelang", "triton"]},
    "bindings": {"type": "object"},
    "materialization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["resolver_kwargs", "args", "kwargs"],
      "properties": {
        "resolver_kwargs": {"type": "object"},
        "args": {"type": "array"},
        "kwargs": {"type": "object"}
      }
    },
    "compiler": {
      "type": "object",
      "additionalProperties": true,
      "required": ["grid", "selected_cta"],
      "properties": {
        "grid": {"type": "array", "minItems": 1, "maxItems": 3, "items": {"type": "integer", "minimum": 1}},
        "selected_cta": {"const": [0, 0, 0]}
      }
    },
    "numeric": {
      "type": "object",
      "additionalProperties": false,
      "required": ["oracle", "seed", "atol", "rtol", "timeout_seconds"],
      "properties": {
        "oracle": {"type": "string", "minLength": 1},
        "seed": {"type": "integer", "minimum": 0},
        "atol": {"type": "number", "minimum": 0},
        "rtol": {"type": "number", "minimum": 0},
        "timeout_seconds": {"type": "number", "exclusiveMinimum": 0}
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["backend", "arch", "warp_size"],
      "properties": {
        "backend": {"const": "cuda"},
        "arch": {"enum": ["sm90", "sm_90a"]},
        "warp_size": {"const": 32}
      }
    }
  }
}
